<section class="trust-badges-section" style="background: {{ section.settings.bg_color | default: '#FAF6F0' }}; {% if section.settings.show_border %}border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);{% endif %}">
  <div class="container">
    <div class="trust-badges-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="trust-badge-item" {{ block.shopify_attributes }}>
            <div class="trust-badge-icon">
              {% case block.settings.icon %}
                {% when 'truck' %}
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                {% when 'lab' %}
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                  </svg>
                {% when 'clock' %}
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                {% else %}
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
              {% endcase %}
            </div>
            <div class="trust-badge-text">
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Fallback Badges -->
        <div class="trust-badge-item">
          <div class="trust-badge-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div class="trust-badge-text">
            <h4>30-Day Money Back</h4>
            <p>If you do not experience the clean energy lift, 100% full refund. Keep the bag on us.</p>
          </div>
        </div>

        <div class="trust-badge-item">
          <div class="trust-badge-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <div class="trust-badge-text">
            <h4>Free Express Freight</h4>
            <p>Free standard shipping on orders over $45. Dispatched within 24 hours from local roasters.</p>
          </div>
        </div>

        <div class="trust-badge-item">
          <div class="trust-badge-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <div class="trust-badge-text">
            <h4>Third-Party Lab Tested</h4>
            <p>Every batch is certified for purity, microbials, and true 100% label protein accuracy.</p>
          </div>
        </div>

        <div class="trust-badge-item">
          <div class="trust-badge-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="trust-badge-text">
            <h4>Slow Cold Steeping</h4>
            <p>18-hour sub-zero brew yields 67% less acid than standard drip coffee for easy digestion.</p>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF6F0"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show Top & Bottom Borders",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Badge Title",
          "default": "30-Day Money Back"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Badge Description",
          "default": "If you do not experience the clean energy lift, 100% full refund. Keep the bag on us."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon Symbol",
          "options": [
            {
              "value": "shield",
              "label": "Shield (Guarantee)"
            },
            {
              "value": "truck",
              "label": "Delivery Truck (Shipping)"
            },
            {
              "value": "lab",
              "label": "Lab Box (Testing)"
            },
            {
              "value": "clock",
              "label": "Clock (Time/Extraction)"
            }
          ],
          "default": "shield"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "title": "30-Day Money Back",
            "text": "If you do not experience the clean energy lift, 100% full refund. Keep the bag on us.",
            "icon": "shield"
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Free Express Freight",
            "text": "Free standard shipping on orders over $45. Dispatched within 24 hours from local roasters.",
            "icon": "truck"
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Third-Party Lab Tested",
            "text": "Every batch is certified for purity, microbials, and true 100% label protein accuracy.",
            "icon": "lab"
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Slow Cold Steeping",
            "text": "18-hour sub-zero brew yields 67% less acid than standard drip coffee for easy digestion.",
            "icon": "clock"
          }
        }
      ]
    }
  ]
}
{% endschema %}
