<footer class="site-footer">
  <div class="container">
    <div class="footer-top-grid">
      <!-- Col 1: Brand & Socials -->
      <div class="footer-brand">
        <a href="/" class="header-logo">
          {{ section.settings.brand_name | default: 'Vittal' }}<span>.</span>
        </a>
        <p>
          {{ section.settings.about_text | default: 'Crafted for focused performance and pure coffee ritual. 20g clean plant protein infused into artisan cold-steeped Colombian Arabica with zero artificial taste.' }}
        </p>
        {% if section.settings.show_social %}
          <div class="footer-socials">
            <a href="{{ settings.social_instagram_link | default: '#' }}" class="social-icon-btn" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="{{ settings.social_twitter_link | default: '#' }}" class="social-icon-btn" aria-label="Twitter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
            </a>
            <a href="{{ settings.social_youtube_link | default: '#' }}" class="social-icon-btn" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
            </a>
            <a href="{{ settings.social_tiktok_link | default: '#' }}" class="social-icon-btn" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            </a>
          </div>
        {% endif %}
      </div>

      <!-- Col 2: EXPLORE -->
      <div class="footer-nav-col">
        <h4>{{ section.settings.menu_1_heading | default: 'Explore' }}</h4>
        <ul class="footer-links">
          {% if section.settings.menu_1 != blank and linklists[section.settings.menu_1].links.size > 0 %}
            {% for link in linklists[section.settings.menu_1].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/collections/all">Our Coffee</a></li>
            <li><a href="/collections/bundles">Subscription Bundles</a></li>
            <li><a href="#benefits">Protein Sourcing</a></li>
            <li><a href="#compare">Nutrition Panels</a></li>
            <li><a href="#story">Lab Test Results</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Col 3: COMPANY -->
      <div class="footer-nav-col">
        <h4>{{ section.settings.menu_2_heading | default: 'Company' }}</h4>
        <ul class="footer-links">
          {% if section.settings.menu_2 != blank and linklists[section.settings.menu_2].links.size > 0 %}
            {% for link in linklists[section.settings.menu_2].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="#story">Our Heritage</a></li>
            <li><a href="#reviews">Verified Reviews</a></li>
            <li><a href="#faq">FAQ & Support</a></li>
            <li><a href="/pages/shipping">Shipping & Returns</a></li>
            <li><a href="/pages/wholesale">Wholesale Inquiries</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Col 4: Newsletter -->
      <div class="footer-newsletter">
        <h4>{{ section.settings.newsletter_heading | default: 'Get 15% off your first order' }}</h4>
        <p>{{ section.settings.newsletter_text | default: 'Receive exclusive flavor drops, morning wellness rituals, and cold-brew batches straight to your inbox.' }}</p>
        
        <form class="newsletter-form">
          <input type="email" class="newsletter-input" placeholder="Enter your email" required />
          <button type="submit" class="newsletter-btn">Subscribe</button>
        </form>
        <span style="font-size: 0.725rem; color: var(--color-text-subtle);">No spam. Unsubscribe anytime with 1-click.</span>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'Vittal Beverages Inc. All rights reserved. Clean Fuel. Real Ritual.' }}
      </div>
      {% if section.settings.show_payments %}
        <div class="payment-badges-row">
          <span>💳 VISA</span>
          <span>💳 MASTERCARD</span>
          <span> APPLE PAY</span>
          <span>🔒 SECURE 256-BIT</span>
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Logo Text",
      "default": "Vittal"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Brand Description",
      "default": "Crafted for focused performance and pure coffee ritual. 20g clean plant protein infused into artisan cold-steeped Colombian Arabica with zero artificial taste."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Media Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "Menu 1 Heading",
      "default": "Explore"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1 Links"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Menu 2 Heading",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2 Links"
    },
    {
      "type": "header",
      "content": "Newsletter Signup"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Get 15% off your first order"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter Caption",
      "default": "Receive exclusive flavor drops, morning wellness rituals, and cold-brew batches straight to your inbox."
    },
    {
      "type": "header",
      "content": "Copyright & Payments"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Suffix",
      "default": "Vittal Beverages Inc. All rights reserved. Clean Fuel. Real Ritual."
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Show Payment Badges",
      "default": true
    }
  ]
}
{% endschema %}
