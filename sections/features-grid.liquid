<section class="features-section" id="benefits">
  <div class="container">
    <div class="section-header">
      <span class="text-uppercase-label" style="display: inline-flex; align-items: center; gap: 6px;">
        <span style="width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent-gold);"></span>
        {{ section.settings.tag_label | default: 'THE VITTAL STANDARD' }}
      </span>
      <h2>{{ section.settings.title | default: 'A functional morning brew meticulously engineered.' }}</h2>
      <p>{{ section.settings.subtitle | default: 'Clean, ready-to-mix ritual supercharged with a restorative blend of 20g clean plant protein for an elevated energy boost that sustains without the chalky stomach distress.' }}</p>
    </div>

    <div class="features-grid">
      <!-- Card 1 -->
      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <h3>{{ section.settings.card_1_title | default: '18-Hour Slow Brew' }}</h3>
        <p>{{ section.settings.card_1_desc | default: 'Cold-dripped Colombian Supremo beans to eliminate crisp acidity, leaving a smooth, velvety profile of cocoa and toasted almond notes.' }}</p>
        <span class="feature-tag">{{ section.settings.card_1_tag | default: 'SILK SMOOTH • LOW ACIDITY' }}</span>
      </div>

      <!-- Card 2 -->
      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2E7D32" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <path d="M2 17l10 5 10-5"></path>
            <path d="M2 12l10 5 10-5"></path>
          </svg>
        </div>
        <h3>{{ section.settings.card_2_title | default: '20g Pure Plant Isolate' }}</h3>
        <p>{{ section.settings.card_2_desc | default: 'Organic cold-pressed yellow pea and sprouted brown rice isolate delivers all 9 essential amino acids without gut bloating or chalkiness.' }}</p>
        <span class="feature-tag">{{ section.settings.card_2_tag | default: 'FAST DIGESTION • ZERO BLOAT' }}</span>
      </div>

      <!-- Card 3 -->
      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C59964" stroke-width="2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <h3>{{ section.settings.card_3_title | default: 'Sustained Brain Fuel' }}</h3>
        <p>{{ section.settings.card_3_desc | default: 'Natural caffeine gently buffered by restorative micronutrients so your focus stays locked in for 6+ hours with zero jitters or afternoon crashes.' }}</p>
        <span class="feature-tag">{{ section.settings.card_3_tag | default: 'COGNITIVE CLARITY • 6+ HOURS' }}</span>
      </div>

      <!-- Card 4 -->
      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2E7D32" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3>{{ section.settings.card_4_title | default: 'Sweetened by Plants' }}</h3>
        <p>{{ section.settings.card_4_desc | default: 'Zero erythritol, zero sucralose, zero chemical bitterness. Naturally rounded with pure monk fruit extract for a silky clean finish.' }}</p>
        <span class="feature-tag">{{ section.settings.card_4_tag | default: 'ZERO ADDED SUGARS • KETO READY' }}</span>
      </div>
    </div>
  </div>
</section>

