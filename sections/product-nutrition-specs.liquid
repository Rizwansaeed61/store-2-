<section class="nutrition-specs-section" style="padding: 80px 0; background: #FAF7F2; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="container">
    <div class="section-header">
      <span class="text-uppercase-label">{{ section.settings.top_label | default: '● THE VITTAL STANDARD' }}</span>
      <h2 style="font-size: 2.85rem;">{{ section.settings.heading | default: 'Formulated for Taste.<br>Engineered for Impact.' }}</h2>
      <p>{{ section.settings.subheading | default: 'We eliminated the chalky texture and chemical sugar substitutes common in standard fitness supplements.' }}</p>
    </div>

    <!-- 3 Formula Columns -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 64px;">
      <!-- Col 1 -->
      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg>
        </div>
        <h3>{{ section.settings.formula_1_title | default: 'Real Colombian Arabica' }}</h3>
        <p>{{ section.settings.formula_1_desc | default: 'Cold-extracted over 18 hours to allow temperatures to lock in velvety dark chocolate and hazelnut undertones without harsh acidity.' }}</p>
        <span class="feature-tag">{{ section.settings.formula_1_tag | default: '120MG NATURAL CAFFEINE' }}</span>
      </div>

      <!-- Col 2 -->
      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
        </div>
        <h3>{{ section.settings.formula_2_title | default: '20g Clean Plant Protein' }}</h3>
        <p>{{ section.settings.formula_2_desc | default: 'Dual-source blend of organic yellow pea and sprouted brown rice isolate delivers all 9 essential amino acids with 4.2g naturally occurring BCAAs.' }}</p>
        <span class="feature-tag">{{ section.settings.formula_2_tag | default: 'EASY DIGESTION • ZERO BLOAT' }}</span>
      </div>

      <!-- Col 3 -->
      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
        </div>
        <h3>{{ section.settings.formula_3_title | default: 'Zero Added Sugars' }}</h3>
        <p>{{ section.settings.formula_3_desc | default: 'Naturally rounded with pure monk fruit extract and prebiotic soluble tapioca fiber for steady glycemic response and sustained afternoon focus.' }}</p>
        <span class="feature-tag">{{ section.settings.formula_3_tag | default: 'ONLY 2G NET CARBS • KETO READY' }}</span>
      </div>
    </div>

    <!-- How Vittal Compares to Daily Habits -->
    <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 48px; box-shadow: var(--shadow-sm);">
      <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 48px; align-items: center;">
        <div>
          <span class="text-uppercase-label">{{ section.settings.compare_label | default: '● NUTRITIONAL TRANSPARENCY' }}</span>
          <h3 style="font-size: 2rem; margin: 12px 0 16px;">{{ section.settings.compare_heading | default: 'How Vittal Compares to Your Daily Habits' }}</h3>
          <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">
            {{ section.settings.compare_desc | default: 'Most commercial iced coffees load your body with 54+ grams of refined cane sugar and zero recovery fuel. Vittal delivers your morning cup into functional nutrition.' }}
          </p>
        </div>

        <!-- 4 Metric Cards -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div style="background: var(--color-surface-soft); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 20px;">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase;">{{ section.settings.metric_1_label | default: 'PROTEIN MATRIX' }}</div>
            <div style="font-size: 2.25rem; font-weight: 900; color: var(--color-text);">{{ section.settings.metric_1_val | default: '20g' }}</div>
            <div style="font-size: 0.75rem; color: var(--color-text-subtle); margin-top: 4px;">{{ section.settings.metric_1_sub | default: '40% Recommended Daily Value' }}</div>
          </div>

          <div style="background: var(--color-surface-soft); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 20px;">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase;">{{ section.settings.metric_2_label | default: 'NATURAL CAFFEINE' }}</div>
            <div style="font-size: 2.25rem; font-weight: 900; color: var(--color-text);">{{ section.settings.metric_2_val | default: '120mg' }}</div>
            <div style="font-size: 0.75rem; color: var(--color-text-subtle); margin-top: 4px;">{{ section.settings.metric_2_sub | default: 'Equivalent to 1.5 espresso shots' }}</div>
          </div>

          <div style="background: var(--color-surface-soft); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 20px;">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase;">{{ section.settings.metric_3_label | default: 'ADDED SUGAR' }}</div>
            <div style="font-size: 2.25rem; font-weight: 900; color: var(--color-text);">{{ section.settings.metric_3_val | default: '0g' }}</div>
            <div style="font-size: 0.75rem; color: var(--color-text-subtle); margin-top: 4px;">{{ section.settings.metric_3_sub | default: 'Sweetened by organic monk fruit' }}</div>
          </div>

          <div style="background: var(--color-surface-soft); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 20px;">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase;">{{ section.settings.metric_4_label | default: 'MICRONUTRIENTS' }}</div>
            <div style="font-size: 2.25rem; font-weight: 900; color: var(--color-text);">{{ section.settings.metric_4_val | default: '100%' }}</div>
            <div style="font-size: 0.75rem; color: var(--color-text-subtle); margin-top: 4px;">{{ section.settings.metric_4_sub | default: 'B6, B12, Iron & Zinc Fortified' }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

