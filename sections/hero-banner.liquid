<section class="hero-section">
  <div class="container">
    <!-- Meta Top Bar -->
    <div class="hero-meta-bar">
      <div class="hero-rating-wrap">
        {% render 'rating-stars', rating: 4.9, count: 1420 %}
      </div>
      <div class="hero-micro-tags">
        <span style="display: inline-flex; align-items: center; gap: 6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C59964" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          10-15s Prep (Instant)
        </span>
        <span style="display: inline-flex; align-items: center; gap: 6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2E7D32" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          20g Clean Protein
        </span>
        <span style="display: inline-flex; align-items: center; gap: 6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3c5f78" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/></svg>
          Lab Tested Purity
        </span>
      </div>
    </div>

    <!-- Hero Content Grid -->
    <div class="hero-grid">
      <!-- Left Column: Copy & CTAs -->
      <div class="hero-content">
        <span class="text-uppercase-label" style="display: inline-flex; align-items: center; gap: 6px;">
          <span style="width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent-gold);"></span>
          100% FUNCTIONAL COLD BREW RITUAL
        </span>
        
        <h1 class="hero-title">
          {{ section.settings.heading_line1 | default: 'Clean Fuel.' }}<br>
          {{ section.settings.heading_line2 | default: 'Real Coffee.' }}<br>
          <span class="serif-italic">{{ section.settings.heading_italic | default: 'Zero Compromise.' }}</span>
        </h1>

        <p class="hero-subtitle">
          {{ section.settings.subtitle | default: 'Crafted with 100% single-origin Colombian Arabica coffee, ultra-pure 18-hour cold brew, and premium 20g plant protein isolate. Naturally light, fast-dissolving, no grit, zero chemicals.' }}
        </p>

        <!-- Nutrition Metric Cards -->
        <div class="hero-stats-row">
          <div class="hero-stat-card">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
              <span class="hero-stat-value">20<span style="font-size: 1rem;">g</span></span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-gold)" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <div class="hero-stat-label">Plant Protein / Serving</div>
          </div>
          <div class="hero-stat-card">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
              <span class="hero-stat-value">0<span style="font-size: 1rem;">g</span></span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2E7D32" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            </div>
            <div class="hero-stat-label">Added Sugar (Monk Fruit)</div>
          </div>
          <div class="hero-stat-card">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
              <span class="hero-stat-value">120<span style="font-size: 1rem;">mg</span></span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C59964" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <div class="hero-stat-label">Natural Arabica Caffeine</div>
          </div>
        </div>

        <!-- Buttons -->
        <div class="hero-cta-group">
          <a href="{{ section.settings.cta_url | default: '/products/vittal-protein-iced-coffee' }}" class="btn btn-primary">
            {{ section.settings.cta_text | default: 'Shop Protein Iced Coffee' }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="{{ section.settings.secondary_cta_url | default: '#compare' }}" class="btn btn-secondary">
            {{ section.settings.secondary_cta_text | default: 'Compare Ingredients' }}
          </a>
        </div>

        <!-- Micro Shipping Notice -->
        <div class="hero-shipping-notice">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>{{ section.settings.shipping_notice | default: 'Free US Standard shipping on $45+. Order today, ships within 24 hours.' }}</span>
        </div>
      </div>

      <!-- Right Column: Hero Visual Product Photography -->
      <div class="hero-visual-card" style="overflow: hidden; padding: 0;">
        <!-- Floating Badges -->
        <div class="hero-floating-badge" style="top: 20px; left: 24px; z-index: 5;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2E7D32" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>
          <span>100% Vegan</span>
        </div>
        <div class="hero-floating-badge" style="top: 20px; right: 24px; z-index: 5;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C59964" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>20g Protein</span>
        </div>
        <div class="hero-floating-badge" style="bottom: 24px; left: 24px; z-index: 5;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>18-Hour Steep</span>
        </div>
        <div class="hero-floating-badge" style="bottom: 24px; right: 24px; z-index: 5;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#A57843" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/></svg>
          <span>Sustained Clean Energy</span>
        </div>

        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'hero-photo-zoom', style: 'width: 100%; height: 520px; object-fit: cover; display: block; transition: transform 0.6s ease;' }}
        {% else %}
          <img 
            src="{{ 'vittal-pouch.jpg' | asset_url }}" 
            alt="Vittal Protein Iced Coffee & Glass" 
            style="width: 100%; height: 520px; object-fit: cover; display: block; transition: transform 0.6s ease;"
            class="hero-photo-zoom"
          />
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "Clean Fuel."
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2",
      "default": "Real Coffee."
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading Italic Accent",
      "default": "Zero Compromise."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Crafted with 100% single-origin Colombian Arabica coffee, ultra-pure 18-hour cold brew, and premium 20g plant protein isolate. Naturally light, fast-dissolving, no grit, zero chemicals."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Product Image"
    },
    {
      "type": "header",
      "content": "Call To Actions"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Primary CTA Text",
      "default": "Shop Protein Iced Coffee"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "Compare Ingredients"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA Link"
    },
    {
      "type": "header",
      "content": "Notices"
    },
    {
      "type": "text",
      "id": "shipping_notice",
      "label": "Shipping Notice Text",
      "default": "Free US Standard shipping on $45+. Order today, ships within 24 hours."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
