<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <!-- Mobile Toggle -->
      <button class="header-action-btn mobile-menu-toggle" aria-label="Toggle navigation menu" onclick="document.querySelector('.header-nav').classList.toggle('active')">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Brand Logo -->
      <a href="/" class="header-logo">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 300 | image_tag: class: 'header-custom-logo', style: 'max-width: ' | append: section.settings.logo_width | append: 'px; height: auto;' }}
        {% else %}
          {{ section.settings.logo_text | default: 'Vittal' }}<span>.</span>
        {% endif %}
      </a>

      <!-- Desktop Navigation -->
      <nav class="header-nav" role="navigation">
        {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
          {% for link in linklists[section.settings.menu].links %}
            <a href="{{ link.url }}" class="header-nav-link {% if link.active %}active{% endif %}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a href="/collections/all" class="header-nav-link active">Shop</a>
          <a href="#benefits" class="header-nav-link">Benefits</a>
          <a href="#ingredients" class="header-nav-link">Ingredients</a>
          <a href="#story" class="header-nav-link">Our Story</a>
          <a href="#reviews" class="header-nav-link">Reviews</a>
        {% endif %}
      </nav>

      <!-- Action Icons -->
      <div class="header-actions">
        {% if section.settings.show_search %}
          <a href="/search" class="header-action-btn" aria-label="Search">
            {% render 'icon-search' %}
          </a>
        {% endif %}
        {% if section.settings.show_account %}
          <a href="/account" class="header-action-btn" aria-label="Account">
            {% render 'icon-user' %}
          </a>
        {% endif %}
        {% if section.settings.show_cart %}
          <button class="header-action-btn" data-action="open-cart" aria-label="Cart">
            {% render 'icon-cart' %}
            <span class="cart-count-bubble">1</span>
          </button>
        {% endif %}
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Custom Logo Width (px)",
      "min": 60,
      "max": 240,
      "step": 10,
      "default": 130
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text (if no image)",
      "default": "Vittal"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Action Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Icon",
      "default": true
    }
  ]
}
{% endschema %}
