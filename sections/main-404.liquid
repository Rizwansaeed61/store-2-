<div class="not-found-section" style="padding: 96px 0; text-align: center;">
  <div class="container container-narrow">
    <span class="text-uppercase-label">● 404 ERROR</span>
    <h1 style="font-size: 3.5rem; margin: 16px 0 20px;">Brew Not Found</h1>
    <p style="color: var(--color-text-muted); font-size: 1.1rem; max-width: 480px; margin: 0 auto 32px;">
      The page you are looking for has been moved, steeped too long, or does not exist.
    </p>
    <a href="/" class="btn btn-primary">
      Return to Homepage &rarr;
    </a>
  </div>
</div>

