<div class="not-found-section" style="padding: 96px 0; text-align: center;">
  <div class="container container-narrow">
    <span class="text-uppercase-label">{{ section.settings.tag_label | default: '● 404 ERROR' }}</span>
    <h1 style="font-size: 3.5rem; margin: 16px 0 20px;">{{ section.settings.heading | default: 'Brew Not Found' }}</h1>
    <p style="color: var(--color-text-muted); font-size: 1.1rem; max-width: 480px; margin: 0 auto 32px;">
      {{ section.settings.subheading | default: 'The page you are looking for has been moved, steeped too long, or does not exist.' }}
    </p>
    <a href="{{ section.settings.button_url | default: '/' }}" class="btn btn-primary">
      {{ section.settings.button_label | default: 'Return to Homepage &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Main 404",
  "settings": [
    {
      "type": "text",
      "id": "tag_label",
      "label": "Top Error Tag",
      "default": "● 404 ERROR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Brew Not Found"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "default": "The page you are looking for has been moved, steeped too long, or does not exist."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Return to Homepage →"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
