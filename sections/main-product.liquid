<div class="product-pdp-section" style="padding: 24px 0 64px;">
  <div class="container">
    <!-- Breadcrumbs -->
    <div style="font-size: 0.8125rem; color: var(--color-text-muted); margin-bottom: 24px;">
      <a href="/">Home</a> &rsaquo; <a href="/collections/all">Clean Performance</a> &rsaquo; <span style="color: var(--color-text);">Vittal Protein Iced Coffee</span>
    </div>

    <div class="buy-box-card" style="padding: 48px 40px; margin-bottom: 64px;">
      <!-- Product Gallery -->
      <div class="product-gallery-column">
        <div class="product-gallery-main" style="position: relative;">
          <!-- Top Floating Tag -->
          <div style="position: absolute; top: 16px; left: 16px; z-index: 5;">
            <span class="pill-badge pill-badge-dark">● 100% COLD BREWED</span>
          </div>

          <img 
            id="main-gallery-image" 
            src="{{ 'vittal-pouch.svg' | asset_url }}" 
            alt="Vittal Protein Iced Coffee Pouch" 
            style="max-height: 420px; object-fit: contain;"
          />

          <!-- Bottom Micro Tags -->
          <div style="position: absolute; bottom: 14px; left: 0; right: 0; display: flex; justify-content: center; gap: 12px; font-size: 0.725rem; color: var(--color-text-muted); font-weight: 700;">
            <span>● 100% Arabica Roast</span>
            <span>● Non-GMO Certified</span>
            <span>● Zero Chalkiness</span>
          </div>
        </div>

        <!-- Thumbnails -->
        <div class="product-gallery-thumbs" style="margin-top: 20px;">
          <div class="thumb-item active" data-img-src="{{ 'vittal-pouch.svg' | asset_url }}">
            <img src="{{ 'vittal-pouch.svg' | asset_url }}" alt="Pouch" style="height: 60px; margin: 0 auto;" />
          </div>
          <div class="thumb-item" data-img-src="{{ 'vittal-glass.svg' | asset_url }}">
            <img src="{{ 'vittal-glass.svg' | asset_url }}" alt="Iced Glass" style="height: 60px; margin: 0 auto;" />
          </div>
          <div class="thumb-item" data-img-src="{{ 'vittal-shaker.svg' | asset_url }}">
            <img src="{{ 'vittal-shaker.svg' | asset_url }}" alt="Shaker" style="height: 60px; margin: 0 auto;" />
          </div>
          <div class="thumb-item" data-img-src="{{ 'vittal-bundle.svg' | asset_url }}">
            <img src="{{ 'vittal-bundle.svg' | asset_url }}" alt="Bundle" style="height: 60px; margin: 0 auto;" />
          </div>
        </div>
      </div>

      <!-- Product Form Column -->
      <div class="product-info-column">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
          <span class="pill-badge pill-badge-gold" style="font-size: 0.7rem;">TOP RATED</span>
          {% render 'rating-stars', rating: 4.9, count: 1420 %}
        </div>

        <h1 style="font-size: 2.85rem; margin-bottom: 8px; line-height: 1.1;">
          Vittal Protein
          <span class="product-servings-badge" style="font-size: 0.85rem;">20 Servings</span>
        </h1>

        <p style="color: var(--color-text-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 24px;">
          Cold-extracted Colombian Arabica blended seamlessly with complete micro-filtered plant protein. No chalk, no odor, pure clean morning stamina.
        </p>

        <!-- Price Display -->
        <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 24px;">
          <span id="current-price-display" style="font-size: 2rem; font-weight: 900; color: var(--color-text);">$39</span>
          <span style="font-size: 1.15rem; text-decoration: line-through; color: var(--color-text-subtle);">$49</span>
          <span class="pill-badge pill-badge-dark" style="font-size: 0.7rem;">SAVE 20%</span>
        </div>

        <!-- 4 Quick Benefits Grid -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px;">
          <div class="spec-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <div>
              <div style="font-weight: 700;">Iron &amp; B Vitamins</div>
              <div style="font-size: 0.7rem; color: var(--color-text-muted);">Daily vitality support</div>
            </div>
          </div>
          <div class="spec-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <div>
              <div style="font-weight: 700;">Bone Support</div>
              <div style="font-size: 0.7rem; color: var(--color-text-muted);">Calcium &amp; D3 paired</div>
            </div>
          </div>
          <div class="spec-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <div>
              <div style="font-weight: 700;">Supports Muscle</div>
              <div style="font-size: 0.7rem; color: var(--color-text-muted);">20g amino-rich isolate</div>
            </div>
          </div>
          <div class="spec-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <div>
              <div style="font-weight: 700;">Top Quality</div>
              <div style="font-size: 0.7rem; color: var(--color-text-muted);">Independent 3rd-party lab</div>
            </div>
          </div>
        </div>

        <!-- Subscription Selector -->
        <div class="purchase-options">
          <div class="purchase-option-card active" data-price="39.00" data-variant="Subscribe & Save 20%">
            <div class="option-header">
              <label class="option-radio-label">
                <input type="radio" name="pdp-purchase-type" checked style="accent-color: var(--color-espresso-dark);" />
                <span>Subscribe &amp; Save 20%</span>
                <span class="pill-badge pill-badge-dark" style="font-size: 0.65rem; padding: 2px 8px;">MOST POPULAR</span>
              </label>
              <div class="option-price-box">
                <span class="option-price-main">$39.00</span>
                <span style="font-size: 0.75rem; color: var(--color-text-muted);">/ bag</span>
              </div>
            </div>
            <div class="option-details">
              Delivered free every 30 days. Pause, swap flavors, or cancel anytime with 1-click.
            </div>
          </div>

          <div class="purchase-option-card" data-price="49.00" data-variant="One-Time Purchase">
            <div class="option-header">
              <label class="option-radio-label">
                <input type="radio" name="pdp-purchase-type" style="accent-color: var(--color-espresso-dark);" />
                <span>One-Time Purchase</span>
              </label>
              <div class="option-price-box">
                <span class="option-price-main">$49.00</span>
              </div>
            </div>
            <div class="option-details">
              Single 20-serving pouch without commitment.
            </div>
          </div>
        </div>

        <!-- Stock Notice -->
        <div style="display: flex; align-items: center; gap: 8px; font-size: 0.8125rem; font-weight: 600; color: #2E7D32; margin-bottom: 20px;">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: #2E7D32;"></span>
          <span>In Stock &mdash; Order today to receive by {{ 'now' | date: '%b %d' }}</span>
        </div>

        <!-- Add to Cart Row -->
        <div class="buy-actions-row">
          <div class="qty-selector qty-selector-group">
            <button class="qty-btn" data-qty-action="minus">&minus;</button>
            <input class="qty-input" id="pdp-quantity" type="text" value="1" readonly />
            <button class="qty-btn" data-qty-action="plus">&plus;</button>
          </div>

          <button 
            id="main-atc-button"
            class="btn btn-primary add-to-cart-btn" 
            data-action="add-to-cart"
            data-product-title="Vittal Protein Iced Coffee"
            data-product-price="39.00"
            data-product-variant="Subscribe & Save 20%"
            data-product-image="{{ 'vittal-pouch.svg' | asset_url }}"
          >
            <span>ADD TO CART &mdash; <span class="atc-dynamic-price">$39.00</span></span>
          </button>
        </div>

        <!-- Guarantees -->
        <div class="micro-guarantees-row">
          <span>🛡️ 30-Day Money-Back Guarantee</span>
          <span>🚚 Free Express Delivery</span>
          <span>🔒 256-Bit SSL Checkout</span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Product (PDP)",
  "settings": []
}
{% endschema %}
