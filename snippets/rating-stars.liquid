{% comment %}
  Renders a 5-star rating graphic
  Accepts:
  - rating: {Float} e.g. 4.9
  - count: {Integer} e.g. 1420
{% endcomment %}
<div class="rating-stars-wrapper" style="display: inline-flex; align-items: center; gap: 4px;">
  <span style="display: inline-flex; gap: 2px; color: #C59964;">
    {% for i in (1..5) %}
      {% render 'icon-star' %}
    {% endfor %}
  </span>
  {% if rating %}
    <span style="font-weight: 700; font-size: 0.875rem; color: var(--color-text);">{{ rating }}</span>
  {% endif %}
  {% if count %}
    <span style="color: var(--color-text-muted); font-size: 0.8125rem;">({{ count | default: '1,420+' }} Verified)</span>
  {% endif %}
</div>
